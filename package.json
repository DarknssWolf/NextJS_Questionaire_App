    "next-themes": "^0.4.6",
    "nuqs": "^2.4.3",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.59.0",
    "react-i18next": "^16.0.0",
    "recharts": "^3.1.2",
