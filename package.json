{
  "name": "eye-c-you",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:debug": "cross-env NODE_OPTIONS=\"--inspect --max-old-space-size=4096\" next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=./drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=./drizzle.config.ts",
    "db:drop": "drizzle-kit drop --config=./drizzle.config.ts",
    "db:introspect": "drizzle-kit introspect",
    "db:push": "drizzle-kit push --config=./drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=./drizzle.config.ts",
    "db:seed": "tsx src/server/db/scripts/seed.ts",
    "db:reset": "tsx src/server/db/scripts/reset.ts",
    "db:migrate:prod": "tsx src/server/db/migrate.ts",
    "cron:auto-submit-surveys": "tsx src/server/scripts/auto-submit-surveys.ts",
    "precommit": "pnpm run typecheck && pnpm run lint"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@radix-ui/react-accordion": "^1.2.11",
